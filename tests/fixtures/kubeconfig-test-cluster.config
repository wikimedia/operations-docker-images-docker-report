apiVersion: v1
kind: Config
preferences: {}
current-context: default-system
contexts:
- name: default-system
  context:
    cluster: default-cluster
    user: dockerreport
clusters:
- name: default-cluster
  cluster:
    server: https://test-cluster.svc.eqiad.wmnet:6443
users:
- name: dockerreport
  user:
    client-certificate: testcluster_dockerreport.pem
    client-key: testcluster_dockerreport-key.pem
